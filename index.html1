<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Youssef Ahmed | Web Designer & Developer</title>

<meta name="description"
content="Youssef Ahmed — Web Designer & Developer creating modern responsive websites.">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#070707;
    color:#fff;
    font-family:Arial,Helvetica,sans-serif;
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

/* ================= NAVBAR ================= */

nav{
    height:80px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid #222;
}

.logo{
    font-size:23px;
    font-weight:900;
    letter-spacing:-1px;
}

.logo span{
    color:#c8ff3d;
}

.nav-links{
    display:flex;
    gap:30px;
}

.nav-links a{
    color:#888;
    font-size:14px;
    transition:.3s;
}

.nav-links a:hover{
    color:#c8ff3d;
}

/* ================= HERO ================= */

.hero{
    min-height:82vh;
    display:flex;
    align-items:center;
}

.tag{
    color:#c8ff3d;
    font-size:12px;
    font-weight:bold;
    letter-spacing:3px;
    margin-bottom:25px;
}

.hero h1{
    font-size:clamp(55px,9vw,115px);
    line-height:.87;
    letter-spacing:-7px;
}

.hero h1 span{
    color:#c8ff3d;
}

.hero p{
    max-width:650px;
    color:#999;
    font-size:18px;
    line-height:1.7;
    margin-top:30px;
}

.buttons{
    display:flex;
    gap:14px;
    flex-wrap:wrap;
    margin-top:32px;
}

.btn{
    display:inline-block;
    padding:15px 23px;
    border:1px solid #333;
    border-radius:50px;
    font-weight:bold;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-4px);
}

.primary{
    background:#c8ff3d;
    color:#070707;
    border-color:#c8ff3d;
}

/* ================= STATS ================= */

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    border-top:1px solid #222;
    border-bottom:1px solid #222;
}

.stat{
    padding:32px;
    border-right:1px solid #222;
}

.stat:last-child{
    border-right:none;
}

.stat h2{
    font-size:45px;
    color:#c8ff3d;
}

.stat p{
    color:#777;
    margin-top:8px;
}

/* ================= ABOUT ================= */

section{
    padding:110px 0;
}

.about{
    display:grid;
    grid-template-columns:400px 1fr;
    gap:80px;
    align-items:center;
}

.photo-box{
    position:relative;
}

.profile-image{
    width:100%;
    height:510px;
    object-fit:cover;
    object-position:center 24%;
    display:block;

    border-radius:25px;
    border:1px solid #292929;

    filter:saturate(.9);
}

.photo-label{
    position:absolute;
    bottom:15px;
    left:15px;

    background:rgba(0,0,0,.9);
    border:1px solid #333;

    padding:11px 15px;
    border-radius:12px;

    color:#c8ff3d;
    font-size:11px;
    font-weight:bold;
    letter-spacing:1px;
}

.about-content h2{
    font-size:65px;
    line-height:.95;
    letter-spacing:-4px;
    margin-bottom:25px;
}

.about-content p{
    max-width:600px;
    color:#999;
    font-size:17px;
    line-height:1.8;
}

/* ================= SECTION TITLES ================= */

.section-title{
    border-top:1px solid #222;
    padding-top:25px;

    display:flex;
    justify-content:space-between;
    align-items:end;

    margin-bottom:50px;
}

.section-title h2{
    font-size:50px;
    letter-spacing:-3px;
}

.section-title p{
    color:#777;
}

/* ================= PROJECTS ================= */

.projects{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
}

.project{
    background:#101010;
    border:1px solid #222;
    border-radius:22px;
    overflow:hidden;
    transition:.4s;
}

.project:hover{
    transform:translateY(-8px);
    border-color:#444;
}

.preview{
    height:420px;
    background:white;
    position:relative;
}

.preview iframe{
    width:100%;
    height:100%;
    border:0;
    background:white;
}

.preview-bar{
    position:absolute;
    left:15px;
    right:15px;
    bottom:15px;

    padding:12px 15px;

    display:flex;
    justify-content:space-between;

    background:rgba(0,0,0,.9);
    border-radius:12px;

    font-size:10px;
    font-weight:bold;
    letter-spacing:1px;
}

.preview-bar span{
    color:#c8ff3d;
}

.project-info{
    padding:25px;
}

.project-number{
    color:#c8ff3d;
    font-size:12px;
    font-weight:bold;
}

.project-info h3{
    font-size:30px;
    margin:9px 0;
}

.project-info p{
    color:#777;
    margin-bottom:20px;
}

.project-link{
    font-weight:bold;
}

/* ================= SERVICES ================= */

.services{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.service{
    background:#101010;
    border:1px solid #222;
    border-radius:18px;
    padding:35px;
    transition:.3s;
}

.service:hover{
    transform:translateY(-5px);
    border-color:#444;
}

.service-number{
    color:#c8ff3d;
    font-size:12px;
    font-weight:bold;
}

.service h3{
    font-size:25px;
    margin:30px 0 15px;
}

.service p{
    color:#777;
    line-height:1.7;
}

/* ================= CONTACT ================= */

.contact{
    text-align:center;
    border-top:1px solid #222;
    padding:120px 0;
}

.contact h2{
    font-size:clamp(50px,8vw,100px);
    line-height:.9;
    letter-spacing:-6px;
}

.contact p{
    color:#777;
    font-size:18px;
    margin-top:25px;
}

.contact-buttons{
    justify-content:center;
}

/* ================= FOOTER ================= */

footer{
    border-top:1px solid #222;
    padding:25px 0;

    color:#666;

    display:flex;
    justify-content:space-between;

    font-size:13px;
}

/* ================= MOBILE ================= */

@media(max-width:800px){

    .nav-links{
        display:none;
    }

    .hero h1{
        letter-spacing:-4px;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .stat{
        border-right:none;
        border-bottom:1px solid #222;
    }

    .about{
        grid-template-columns:1fr;
        gap:45px;
    }

    .profile-image{
        height:460px;
    }

    .projects{
        grid-template-columns:1fr;
    }

    .preview{
        height:350px;
    }

    .services{
        grid-template-columns:1fr;
    }

    .section-title{
        display:block;
    }

    .section-title p{
        margin-top:10px;
    }

    footer{
        display:block;
    }

    footer span{
        display:block;
        margin:6px 0;
    }
}
</style>
</head>

<body>

